FROM node:24 as builder

WORKDIR /app

COPY . .

RUN npm install --legacy-peer-deps

RUN npm run build

FROM node:24-alpine AS dev

COPY  package*.json ./

RUN npm install -g vite

COPY  --from=builder /app/dist ./dist

EXPOSE 4174

CMD [ "npm", "run", "preview", "--", "--host", "0.0.0.0", "--port", "4174" ]


